# Wheelians backend configuration
PORT=4000
NODE_ENV=development

# Database
DB_PATH=./data/wheelians.db

# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Admin seed account (used by `npm run seed`)
ADMIN_EMAIL=admin@wheelians.co.ke
ADMIN_PASSWORD=change-this-after-first-login
ADMIN_NAME=Wheelians Admin

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# SMTP — Gmail: enable 2FA, create App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=Wheelians <your-email@gmail.com>
NOTIFY_EMAIL=ianokwengu@gmail.com
