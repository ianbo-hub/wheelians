# Wheelians Environment Configuration
# Copy this file to .env and fill in your values

NODE_ENV=development
PORT=4000

# Database
DB_PATH=./data/wheelians.db

# JWT — REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins, or * for development
CORS_ORIGIN=*

# Admin account (created on first seed)
ADMIN_EMAIL=admin@wheelians.co.ke
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=Wheelians Admin

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# SMTP (optional — emails are silently skipped when not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Wheelians <no-reply@wheelians.co.ke>
NOTIFY_EMAIL=
